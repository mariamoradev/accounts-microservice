# Copie este archivo como .environments/application-secrets.properties y llene los valores.
# Nunca versionar el archivo real (la carpeta .environments esta en .gitignore).

# TiDB
db.host=gateway01.us-east-1.prod.aws.tidbcloud.com
db.port=4000
db.name=crud_usuarios
db.username=REEMPLAZAR.root
db.password=REEMPLAZAR
db.ssl-mode=REQUIRED

# Kafka (Aiven)
kafka.bootstrap-servers=kafka-xxxx.aivencloud.com:12345
kafka.security-protocol=SASL_SSL
kafka.sasl.mechanism=SCRAM-SHA-256
kafka.username=avnadmin
kafka.password=REEMPLAZAR
kafka.ca-cert=-----BEGIN CERTIFICATE-----\nREEMPLAZAR\n-----END CERTIFICATE-----

# Valkey (Guia 10): Service URI de Aiven
cache.valkey.uri=rediss://default:REEMPLAZAR@cache-xxxx.aivencloud.com:12345
